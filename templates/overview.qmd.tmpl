```{=html}
<script>
document.addEventListener(
  "DOMContentLoaded",
  function () {

    const box =
      document.querySelector(
        ".overview-info"
      );

    const button =
      document.querySelector(
        ".overview-expand-button"
      );

    if (!box || !button) {
      return;
    }

    button.addEventListener(
      "click",
      function () {

        const expanded =
          box.classList.toggle(
            "expanded"
          );

        button.setAttribute(
          "aria-expanded",
          String(expanded)
        );

        button.textContent =
          expanded
            ? "Weniger anzeigen"
            : "Mehr anzeigen";
      }
    );
    
        /* ========================================
       Offline introduction
       ======================================== */

    const offlineBox =
      document.getElementById(
        "overview-offline"
      );

    const offlineMain =
      offlineBox?.querySelector(
        ".overview-offline-main"
      );

    const offlineCompact =
      offlineBox?.querySelector(
        ".overview-offline-compact"
      );

    const OFFLINE_INTRO_KEY =
      "offline-intro-seen";


    function showCompactOffline() {

      if (offlineMain) {
        offlineMain.hidden = true;
      }

      if (offlineCompact) {
        offlineCompact.hidden = false;
      }
    }


    if (
      localStorage.getItem(
        OFFLINE_INTRO_KEY
      ) === "true"
    ) {

      showCompactOffline();
    }


    window.openOverviewOfflineManager =
      function () {

        localStorage.setItem(
          OFFLINE_INTRO_KEY,
          "true"
        );

        showCompactOffline();

        if (
          typeof window.openOfflineManager ===
          "function"
        ) {
          window.openOfflineManager();
        }
      };


    window.dismissOverviewOffline =
      function () {

        localStorage.setItem(
          OFFLINE_INTRO_KEY,
          "true"
        );

        showCompactOffline();
      };

  }
);
</script>
```