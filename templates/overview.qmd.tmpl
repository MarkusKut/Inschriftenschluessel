  <div class="nav-buttons">

    <a
      href="menu.html"
      class="btn-home">
      Home
    </a>

    <button
      type="button"
      class="btn-back"
      onclick="
        if (
          document.referrer &&
          document.referrer !== window.location.href
        ) {
          history.back();
        } else {
          window.location.href = 'index.html';
        }
      ">
      ← Zurück
    </button>

    <button
      type="button"
      class="footer-nav-button footer-offline-button"
      onclick="openOfflineManager()">
      Offline
    </button>

  </div>

</div>
```


```{=html}
<script>
document.addEventListener(
  "DOMContentLoaded",
  function () {

    /* ========================================
       Information expand / collapse
       ======================================== */

    const box =
      document.querySelector(
        ".overview-info"
      );

    const button =
      document.querySelector(
        ".overview-expand-button"
      );

    if (box && button) {

      button.addEventListener(
        "click",
        function () {

          const expanded =
            box.classList.toggle(
              "expanded"
            );

          button.setAttribute(
            "aria-expanded",
            String(expanded)
          );

          button.textContent =
            expanded
              ? "Weniger anzeigen"
              : "Mehr anzeigen";
        }
      );
    }


    /* ========================================
       Offline introduction
       ======================================== */

    const offlineBox =
      document.getElementById(
        "overview-offline"
      );

    const OFFLINE_INTRO_KEY =
      "offline-intro-seen";


    function hideOfflineIntro() {

      if (offlineBox) {
        offlineBox.hidden = true;
      }
    }


    /*
     * If the introduction has already
     * been dealt with once, don't show
     * it again.
     */

    if (
      localStorage.getItem(
        OFFLINE_INTRO_KEY
      ) === "true"
    ) {

      hideOfflineIntro();
    }


    /*
     * User chooses to configure
     * offline use.
     */

    window.openOverviewOfflineManager =
      function () {

        localStorage.setItem(
          OFFLINE_INTRO_KEY,
          "true"
        );

        hideOfflineIntro();

        if (
          typeof window.openOfflineManager ===
          "function"
        ) {
          window.openOfflineManager();
        }
      };


    /*
     * User chooses "Später".
     *
     * The introduction disappears,
     * but Offline remains permanently
     * accessible through the footer.
     */

    window.dismissOverviewOffline =
      function () {

        localStorage.setItem(
          OFFLINE_INTRO_KEY,
          "true"
        );

        hideOfflineIntro();
      };

  }
);
</script>
```