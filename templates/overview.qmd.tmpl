```{=html}
<script>
document.addEventListener(
  "DOMContentLoaded",
  function () {

    const box =
      document.querySelector(
        ".overview-info"
      );

    const button =
      document.querySelector(
        ".overview-expand-button"
      );

    if (!box || !button) {
      return;
    }

    button.addEventListener(
      "click",
      function () {

        const expanded =
          box.classList.toggle(
            "expanded"
          );

        button.setAttribute(
          "aria-expanded",
          String(expanded)
        );

        button.textContent =
          expanded
            ? "Weniger anzeigen"
            : "Mehr anzeigen";
      }
    );

  }
);
</script>
```